# Copy to .env and fill in. All vars are prefixed HARNESS_ per pydantic-settings config
# (see harness/config/settings.py). Nothing in this file is a real secret.

# --- Model provider (Anthropic direct API) ---
HARNESS_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
HARNESS_MODEL_ID=anthropic:claude-sonnet-5
HARNESS_TRIAGE_MODEL_ID=anthropic:claude-haiku-4-5-20251001

# --- Embeddings (OpenAI) — backs BOTH tier-1 semantic routing and pgvector
# memory embeddings; one embedding space (see harness/routing/embeddings.py) ---
HARNESS_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HARNESS_EMBEDDING_MODEL_ID=text-embedding-3-small

# --- Postgres / pgvector (memory + session store) ---
HARNESS_DATABASE_URL=postgresql://harness:harness@localhost:5433/harness

# --- OTel Collector (traces fan out to Phoenix + optionally Datadog) ---
# NOTE: this points at the otel-collector container's host-mapped gRPC port (4318),
# NOT Phoenix's own 4317 — the collector is the fan-out point, Phoenix is one of its exporters.
HARNESS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
# PII double-guard half 1: full prompt/response content only ever captured on
# spans when explicitly true (debug/pre-prod only) — never by default.
HARNESS_OTEL_INCLUDE_CONTENT=false

# --- Datadog export (optional; leave unset to keep Datadog exporter idle) ---
DD_API_KEY=
DD_SITE=datadoghq.com

# --- Ablation defaults (per-run flags can override these) ---
HARNESS_MEMORY_ON=true
HARNESS_CRITIC_ON=true
HARNESS_ROUTER_TIER=3
